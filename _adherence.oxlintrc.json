{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/diagrams/**",
              "components/document/**",
              "ui_kits/docs-article/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mulish))/i]",
        "message": "Font not provided by the design system. Available: Mulish."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accent|background|label|children|style|key|ref|className|style|children)$/]",
        "message": "<AccentPanel> doesn't accept that prop. Declared props: variant, accent, background, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentPanel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:note|info|pass|fail)$/]",
        "message": "<AccentPanel> variant must be one of 'note' | 'info' | 'pass' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtAGlance'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|purpose|audience|readingTime|prerequisites|takeaways|style|key|ref|className|style|children)$/]",
        "message": "<AtAGlance> doesn't accept that prop. Declared props: title, purpose, audience, readingTime, prerequisites, takeaways, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfterSide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|points|key|ref|className|style|children)$/]",
        "message": "<BeforeAfterSide> doesn't accept that prop. Declared props: title, points."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|children|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: variant, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:critical|caution|note)$/]",
        "message": "<Callout> variant must be one of 'critical' | 'caution' | 'note'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterTransition'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|next|children|style|key|ref|className|style|children)$/]",
        "message": "<ChapterTransition> doesn't accept that prop. Declared props: label, next, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|points|footnote|tone|key|ref|className|style|children)$/]",
        "message": "<ComparisonItem> doesn't accept that prop. Declared props: title, subtitle, points, footnote, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|note|info|pass|fail)$/]",
        "message": "<ComparisonItem> tone must be one of 'neutral' | 'note' | 'info' | 'pass' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionBranch'] > JSXAttribute > JSXIdentifier[name!=/^(?:answer|result|text|tone|key|ref|className|style|children)$/]",
        "message": "<DecisionBranch> doesn't accept that prop. Declared props: answer, result, text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionBranch'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|pass|fail|caution)$/]",
        "message": "<DecisionBranch> tone must be one of 'neutral' | 'pass' | 'fail' | 'caution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<DocCard> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|links|wordmark|company|disclaimer|version|owner|reviewDate|classification|page|pages|key|ref|className|style|children)$/]",
        "message": "<DocFooter> doesn't accept that prop. Declared props: tagline, links, wordmark, company, disclaimer, version, owner, reviewDate, classification, page, pages."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|standfirst|style|key|ref|className|style|children)$/]",
        "message": "<DocHeader> doesn't accept that prop. Declared props: title, meta, standfirst, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|stat|value|onVote|style|key|ref|className|style|children)$/]",
        "message": "<FeedbackBar> doesn't accept that prop. Declared props: question, stat, value, onVote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackBar'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:yes|no)$/]",
        "message": "<FeedbackBar> value must be one of 'yes' | 'no'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|caption|source|framed|children|style|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: number, title, caption, source, framed, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<InlineCode> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyTakeaway'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|glyph|items|children|style|key|ref|className|style|children)$/]",
        "message": "<KeyTakeaway> doesn't accept that prop. Declared props: label, glyph, items, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LayerStackLayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|items|accent|key|ref|className|style|children)$/]",
        "message": "<LayerStackLayer> doesn't accept that prop. Declared props: name, note, items, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='LifecycleStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|key|ref|className|style|children)$/]",
        "message": "<LifecycleStage> doesn't accept that prop. Declared props: title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|solid|style|key|ref|className|style|children)$/]",
        "message": "<PriorityTag> doesn't accept that prop. Declared props: level, label, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityTag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:critical|required|optional|reference)$/]",
        "message": "<PriorityTag> level must be one of 'critical' | 'required' | 'optional' | 'reference'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBanner> doesn't accept that prop. Declared props: label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RelationshipNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|key|ref|className|style|children)$/]",
        "message": "<RelationshipNode> doesn't accept that prop. Declared props: title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|id|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: level, id, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwimlaneStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|accent|key|ref|className|style|children)$/]",
        "message": "<SwimlaneStep> doesn't accept that prop. Declared props: title, text, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='TermListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:term|text|key|ref|className|style|children)$/]",
        "message": "<TermListItem> doesn't accept that prop. Declared props: term, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|text|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: label, title, text."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
